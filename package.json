{
  "name": "kcli",
  "version": "1.7.1",
  "description": "A Koinos blockchain command line tool",
  "main": "dist/index.js",
  "bin": {
    "kcli": "./dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "tests",
    "evidence",
    "tsconfig.json",
    "README.md",
    "TESTNET_CHANGES.md",
    "DASHBOARD_RPC_RELIABILITY.md",
    "KPS_VOTING_PLAN.md",
    "FUND_RPC_COMPATIBILITY.md",
    "VORTEX_ADMINISTRATOR_GUIDE.md",
    "VORTEX_HANDOFF.md",
    "VORTEX_IMPLEMENTATION_STATUS.md",
    "VORTEX_MAINNET_GOAL_PROMPT.md",
    "MULTISIG_TREASURY_GUIDE.md",
    "MULTISIG_IMPLEMENTATION_STATUS.md",
    "MULTISIG_FINALITY_FIX.md",
    "MULTISIG_RELEASE_VALIDATION.md",
    "contracts/multisig-treasury",
    "RELEASE_NOTES.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "test": "npm run build && node tests/run-tests.js",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "lint": "eslint src/**/*.ts",
    "clean": "rm -rf dist"
