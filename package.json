  "keywords": [
    "koinos",
    "blockchain",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/hdkey": "^2.1.0",
    "@types/node": "^20.10.0",
    "@types/readline-sync": "^1.4.8",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@ethersproject/hdnode": "^5.8.0",
    "bip39": "^3.1.0",
    "commander": "^12.0.0",
    "hdkey": "^2.1.0",
    "koilib": "^9.2.0",
    "readline-sync": "^1.4.10"
  }
}
